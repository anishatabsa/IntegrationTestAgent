# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aita:aita_secret@localhost:5432/aita
DATABASE_POOL_SIZE=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_LLM_CACHE_TTL=86400          # 24 hours in seconds

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic             # anthropic | ollama
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:13b
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2

# ─── Vector Store ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                    # leave empty for local
QDRANT_COLLECTION=aita_knowledge

# ─── Neo4j (Graph RAG — optional) ────────────────────────────────────────────
NEO4J_ENABLED=false
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─── Git ──────────────────────────────────────────────────────────────────────
GIT_DEFAULT_BRANCH=main
GIT_SSH_KEY_PATH=~/.ssh/id_rsa     # or leave empty for HTTPS
GITLAB_TOKEN=glpat-...
GITHUB_TOKEN=ghp_...

# ─── Test Repository ──────────────────────────────────────────────────────────
TEST_REPO_BASE_PATH=./test-repos   # local bare git repos for generated tests

# ─── Docker ───────────────────────────────────────────────────────────────────
DOCKER_TARGET_NETWORK=bridge       # network where target service runs
DOCKER_SOCKET=unix:///var/run/docker.sock

# ─── Allure ───────────────────────────────────────────────────────────────────
ALLURE_SERVER_URL=http://localhost:5050
ALLURE_PROJECT_ID=aita
ALLURE_API_TOKEN=

# ─── QMetry ───────────────────────────────────────────────────────────────────
QMETRY_ENABLED=false
QMETRY_BASE_URL=https://your-org.qmetry.com
QMETRY_API_KEY=
QMETRY_PROJECT_KEY=

# ─── CI Integration ───────────────────────────────────────────────────────────
CI_WEBHOOK_SECRET=change-me        # HMAC secret for GitLab / Jenkins webhooks
